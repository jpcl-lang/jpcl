{
  "name": "jpcl-lang",
  "version": "2.1.0",
  "description": "A hybrid JSON/TOML configuration language (.jp files)",
  "keywords": [
    "config",
    "configuration",
    "parser",
    "toml",
    "json",
    "jp",
    "jpcl"
  ],
  "homepage": "https://github.com/jpcl-lang/jpcl#readme",
  "bugs": {
    "url": "https://github.com/jpcl-lang/jpcl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpcl-lang/jpcl.git",
    "directory": "npm"
  },
  "license": "MIT",
  "author": "Clove Twilight <clove@doughmination.gay>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./highlightjs": {
      "types": "./dist/highlightjs.d.ts",
      "default": "./dist/highlightjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jpcl": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "bun test",
    "prepack": "node -e \"require('node:fs').copyFileSync('../README.md','README.md')\" && npm run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "highlight.js": "11.11.1",
    "typescript": "^7.0.2"
  }
}
